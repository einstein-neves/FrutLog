  {
    "id": "frutlog_separa",
    "type": "function",
    "z": "frutlog_aba",
    "name": "Separa as 3 leituras do ThingSpeak",
    "func": "// Canal ThingSpeak do FrutLog\n//   field1 = Temperatura (C)\n//   field2 = Umidade do ar (%)\n//   field3 = Umidade do solo (%)  -> ainda sem sensor publicando\n// Cada campo sai por uma porta diferente, na ordem abaixo.\nconst CAMPOS = [\n    { campo: \"field1\", topico: \"Temperatura\" },\n    { campo: \"field2\", topico: \"Umidade do ar\" },\n    { campo: \"field3\", topico: \"Umidade do solo\" }\n];\n\nconst resposta = msg.payload || {};\nconst feeds = Array.isArray(resposta.feeds) ? resposta.feeds : [];\n\nif (feeds.length === 0) {\n    node.status({ fill: \"red\", shape: \"ring\", text: \"sem resposta do ThingSpeak\" });\n    return null;\n}\n\n// O ThingSpeak devolve os valores como texto e manda null quando o sensor falha.\nfunction pontos(campo) {\n    return feeds\n        .filter((feed) => {\n            const bruto = feed[campo];\n            if (bruto === null || bruto === undefined) return false;\n            if (String(bruto).trim() === \"\") return false;\n            return Number.isFinite(Number(bruto));\n        })\n        .map((feed) => ({\n            x: new Date(feed.created_at).getTime(),\n            y: Number(feed[campo])\n        }));\n}\n\n// Porta sem dado nenhum devolve null em vez de lista vazia.\n// Assim o grafico nao e apagado, so fica esperando o sensor comecar a publicar.\nconst saidas = CAMPOS.map(({ campo, topico }) => {\n    const dados = pontos(campo);\n    return dados.length === 0 ? null : { topic: topico, payload: dados };\n});\n\nconst vazios = CAMPOS.filter((_, indice) => saidas[indice] === null).map((item) => item.campo);\nnode.status(vazios.length\n    ? { fill: \"yellow\", shape: \"ring\", text: feeds.length + \" leituras - sem dados em \" + vazios.join(\", \") }\n    : { fill: \"green\", shape: \"dot\", text: feeds.length + \" leituras - 3 campos ok\" });\n\nreturn saidas;",
    "outputs": 3,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 610,
    "y": 120,
    "wires": [
      [
        "frutlog_graf_temp"
      ],
      [
        "frutlog_graf_umid"
      ],
      [
        "de14bd5510719fe3"
      ]
    ]
  },
