                "frutlog_separa"
            ]
        ]
    },
    {
        "id": "frutlog_separa",
        "type": "function",
        "z": "frutlog_aba",
        "name": "Separa os 4 dados do ThingSpeak",
        "func": "// No canal do ThingSpeak: field1 = Temperatura, field2 = Umidade do ar,\n// field3 = Umidade do solo, field4 = Chuva\nconst feeds = msg.payload.feeds || [];\n\nfunction pontos(campo) {\n    return feeds\n        .filter((feed) => feed[campo] !== null && feed[campo] !== undefined)\n        .map((feed) => ({ x: new Date(feed.created_at).getTime(), y: Number(feed[campo]) }));\n}\n\n// saida 1: temperatura | 2: umidade do ar | 3: umidade do solo | 4: chuva\nreturn [\n    { topic: \"Temperatura\", payload: pontos(\"field1\") },\n    { topic: \"Umidade do ar\", payload: pontos(\"field2\") },\n    { topic: \"Umidade do solo\", payload: pontos(\"field3\") },\n    { topic: \"Chuva\", payload: pontos(\"field4\") }\n];",
        "outputs": 4,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 580,
        "y": 100,
        "wires": [
            [
                "frutlog_graf_temp"
            ],
            [
                "frutlog_graf_umid"
            ],
            [
                "de14bd5510719fe3"
            ],
            [
                "d0fa93dfa6baa03c"
            ]
        ]
    },
